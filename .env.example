# Mapbox Access Token (Public token with Geocoding and Map rendering scope)
VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZmFybWNvbm5lY3QiLCJhIjoiY2x4eHh4eHh4MDAwMHJ0MXh4eHh4eHh4In0.example_token

# GeoNames API Username for Administrative Hierarchy Lookup
GEONAMES_USERNAME=farmconnect_app

# Backend Server & Auth Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
COOKIE_SECRET=your_cookie_secret_key_here
DATABASE_PATH=database.sqlite

# Phase 3 — OTP Verification Service Configuration
OTP_PROVIDER=console # Options: console | twilio | msg91
OTP_EXPIRY_SECONDS=300
MAX_OTP_ATTEMPTS=5
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id

# Phase 3 — Payment Gateway Integration (UPI & Cards)
PAYMENT_PROVIDER=razorpay # Options: razorpay | stripe | mock_gateway
PAYMENT_KEY_ID=rzp_test_your_key_id
PAYMENT_KEY_SECRET=your_razorpay_secret_key
PAYMENT_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Phase 3 — Distance & Shipping Pricing Configuration
FREE_DELIVERY_THRESHOLD=25000


