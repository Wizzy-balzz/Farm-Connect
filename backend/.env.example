PORT=5000
NODE_ENV=development

DB_HOST=your_mysql_host
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=farmconnect
# MySQL Backup Configuration (Optional)
MYSQL_BACKUP_DIR=./backups/mysql
MYSQL_BACKUP_RETENTION=14
MYSQL_BIN_PATH=


JWT_SECRET=your_jwt_secret
COOKIE_SECRET=your_cookie_secret
GOOGLE_CLIENT_ID=your_google_client_id

RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

FRONTEND_URL=http://localhost:5173

# Email Service Configuration (Options: gmail | console)
EMAIL_PROVIDER=gmail
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_google_app_password
EMAIL_FROM=your_gmail_address@gmail.com

# OTP Verification Service Configuration (Options: gmail | console | twilio | msg91 | fast2sms)
OTP_PROVIDER=gmail
OTP_EXPIRY_SECONDS=300
MAX_OTP_ATTEMPTS=5

# Voice / Speech-to-Text (STT) Configuration
STT_PROVIDER=python
STT_MODEL=local-python-stt
MAX_VOICE_DURATION_SECONDS=60
MAX_VOICE_FILE_SIZE_MB=10
VOICE_RATE_LIMIT_PER_MINUTE=10
VOICE_RATE_LIMIT_PER_HOUR=60

# Voice / Text-to-Speech (TTS) Configuration
TTS_PROVIDER=python
TTS_MODEL=local-python-tts
TTS_VOICE=
MAX_TTS_TEXT_LENGTH=5000
TTS_RATE_LIMIT_PER_MINUTE=20
TTS_RATE_LIMIT_PER_HOUR=100

