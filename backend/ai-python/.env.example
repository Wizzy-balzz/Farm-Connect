# ============================================================
# FarmConnect Python AI/NLP Service Configuration
# ============================================================

# Service Configuration
PYTHON_AI_PORT=8000
PYTHON_AI_HOST=127.0.0.1
DEBUG=false
LOG_LEVEL=INFO

# Internal Security (Node.js <-> Python internal service authentication)
# Header: X-Internal-Service-Key
INTERNAL_API_SECRET=farmconnect_internal_ai_secret_dev_key

# Node.js Application Gateway URL
NODE_BACKEND_URL=http://127.0.0.1:5000

# Database Connection (MySQL - Read-only & AI specific tables)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=farmconnect
DB_POOL_SIZE=5

# Voice & Multimodal Providers
STT_PROVIDER=python
TTS_PROVIDER=python
MAX_VOICE_FILE_SIZE_MB=10
MAX_IMAGE_FILE_SIZE_MB=10
